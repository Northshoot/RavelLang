# ──────────────────────────────────────────────────────────────
# URL Shortener — A complete micro-SaaS in 45 lines of Ravel
# ──────────────────────────────────────────────────────────────
# This is the "Hello World" of Ravel: a production-ready URL
# shortener with analytics, deployed to containers, accessible
# via a web UI. From this file alone, the compiler produces an
# Agent Execution Plan covering database, backend, web frontend,
# Docker, Kubernetes, tests, and security — all generated by
# specialized LLM agents.
# ──────────────────────────────────────────────────────────────

system URLShortener:
    description: "A tiny URL shortener with click analytics"
    version: "1.0.0"

model Link:
    schema:
        id: uuid @primary
        short_code: string @unique
        target_url: string
        clicks: int = 0
        created_at: datetime
    storage: postgres

controller LinkController(links: Link):
    event links.created(link: Link):
        log link.short_code

    event links.clicked(short_code: string):
        link = links.get(short_code)
        link.clicks += 1
        link.save()

view ShortenPage:
    displays: Link
    platform: [web]
    behavior:
        "A single centered input field for pasting a long URL"
        "Big 'Shorten' button below it"
        "After shortening, show the short link with a copy button"
        "Below that, show a table of recent links with click counts"

runtime Backend:
    platform: container
    language: typescript
    controllers: [LinkController]
    models: [Link]

runtime Web:
    platform: web
    views: [ShortenPage]

flow AppFlow:
    Web -> Backend:
        protocol: https
